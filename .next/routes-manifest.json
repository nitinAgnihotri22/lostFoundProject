      "page": "/api/claims/[id]",
      "regex": "^/api/claims/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/claims/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/conversations/[id]/messages",
